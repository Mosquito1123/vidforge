# App
APP_NAME=ai-video-worker
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Celery / Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Model gateway
MODEL_PROVIDER=mock
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=mock-video-v1

# Fal (optional real provider)
FAL_API_KEY=
FAL_MODEL=
FAL_BASE_URL=https://fal.run

# Replicate (optional real provider)
REPLICATE_API_TOKEN=

# S3 / object storage
STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Aliyun OSS (used when STORAGE_PROVIDER=aliyun)
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=cn-shanghai
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_USE_INTERNAL=false
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_STS_TOKEN=
ALIYUN_OSS_PUBLIC_BASE_URL=

# Aliyun CDN signed URLs (URL auth type A)
CDN_DOMAIN=
CDN_AUTH_KEY=
CDN_URL_TTL_SECONDS=3600

# FFmpeg
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
HLS_SEGMENT_DURATION=2

# Moderation
MODERATION_ENABLED=true
MODERATION_PROVIDER=mock
MODERATION_API_KEY=
MODERATION_BASE_URL=
MODERATION_FALLBACK_PROVIDER=openai

# Aliyun content security
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_REGION=cn-shanghai
ALIYUN_CONTENT_SECURITY_ENDPOINT=

# Tencent content security
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou
TENCENT_CONTENT_SECURITY_ENDPOINT=

# API callback
API_BASE_URL=http://localhost:4000
API_INTERNAL_TOKEN=

# Task defaults
TASK_TIME_LIMIT=600
TASK_SOFT_TIME_LIMIT=540

# Retry / backoff
TASK_MAX_RETRIES=3
TASK_RETRY_BACKOFF_SECONDS=5
TASK_RETRY_BACKOFF_MAX=60

# Kafka / event publishing (optional)
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC_EVENTS=ai-video.events
KAFKA_CLIENT_ID=ai-video-worker
