# App
NODE_ENV=development

# Postgres
POSTGRES_USER=aivideo
POSTGRES_PASSWORD=aivideo
POSTGRES_DB=aivideo
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=aivideo
S3_REGION=us-east-1

# Storage provider for domestic deployment: s3 (MinIO) or aliyun (OSS)
STORAGE_PROVIDER=s3

# Aliyun OSS (production; leave empty for local MinIO)
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=cn-shanghai
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_USE_INTERNAL=false
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_PUBLIC_BASE_URL=

# Aliyun CDN (signed playback URLs)
CDN_DOMAIN=
CDN_AUTH_KEY=
CDN_URL_TTL_SECONDS=3600

# API
API_PORT=4000
JWT_SECRET=change-me-in-production

# Worker
WORKER_REPLICAS=1

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Metabase
METABASE_PORT=3001
METABASE_SITE_URL=http://localhost:3001
