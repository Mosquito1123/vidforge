# App
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://aivideo:aivideo@localhost:5432/aivideo?schema=public

# Signup bonus credits granted to new accounts
FREE_TRIAL_CREDITS=50

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Redis / worker
REDIS_URL=redis://localhost:6379/0
WORKER_URL=http://localhost:8000
WORKER_TIMEOUT_MS=10000

# Internal auth between API and worker
API_INTERNAL_TOKEN=change-me-internal-token

# Webhooks
WEBHOOK_SECRET=change-me-webhook-secret

# Object storage provider: s3 (AWS/MinIO) or aliyun (Aliyun OSS)
STORAGE_PROVIDER=s3

# Aliyun OSS (required when STORAGE_PROVIDER=aliyun)
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=cn-shanghai
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_STS_TOKEN=
ALIYUN_OSS_PUBLIC_BASE_URL=

# Aliyun CDN signed URLs (URL auth type A)
CDN_DOMAIN=
CDN_AUTH_KEY=
CDN_URL_TTL_SECONDS=3600
